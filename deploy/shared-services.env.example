# Copy to deploy/shared-services.env on the server. Do not commit the real file.

SHARED_COMPOSE_PROJECT_NAME=shared-infra
SHARED_POSTGRES_IMAGE=postgres:17-alpine
SHARED_POSTGRES_SUPERUSER=postgres
SHARED_POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_SUPERUSER_PASSWORD
SHARED_POSTGRES_HOST_PORT=127.0.0.1:5432
SHARED_POSTGRES_WAL_ARCHIVE_TIMEOUT_SECONDS=900

SHARED_REDIS_IMAGE=redis:7-alpine
SHARED_REDIS_HOST_PORT=127.0.0.1:6379

SHARED_NETWORK_SUBNET=172.30.0.0/24
SHARED_POSTGRES_VOLUME=shared-postgres-data
SHARED_REDIS_VOLUME=shared-redis-data
SHARED_BACKUP_VOLUME=shared-postgres-backups
