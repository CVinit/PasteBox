# Copy to deploy/production.env on the server. Do not commit the real file.

PASTEBOX_IMAGE=ghcr.io/cvinit/pastebox:sha-CHANGE_ME
PASTEBOX_POSTGRES_IMAGE=postgres:17-alpine
PASTEBOX_REDIS_IMAGE=redis:7-alpine
PASTEBOX_CADDY_IMAGE=caddy:2.10-alpine
PASTEBOX_RESTIC_IMAGE=restic/restic:0.18.1
PASTEBOX_PROMETHEUS_IMAGE=prom/prometheus:v2.55.1
PASTEBOX_NODE_EXPORTER_IMAGE=prom/node-exporter:v1.8.2
PASTEBOX_BLACKBOX_EXPORTER_IMAGE=prom/blackbox-exporter:v0.25.0
PASTEBOX_PROMETHEUS_RETENTION=15d

PASTEBOX_DOMAIN=pastebox.example.com
PASTEBOX_ADMIN_EMAIL=admin@example.com

PASTEBOX_APP_ENV=production
PASTEBOX_APP_NAME=PasteBox
PASTEBOX_HTTP_ADDR=:8080
PASTEBOX_PUBLIC_URL=https://pastebox.example.com
PASTEBOX_SUPPORT_EMAIL=support@pastebox.example.com
PASTEBOX_ABUSE_EMAIL=abuse@pastebox.example.com
PASTEBOX_LOG_LEVEL=info
PASTEBOX_CSRF_SECRET=CHANGE_ME_LONG_RANDOM_CSRF_SECRET
PASTEBOX_METRICS_TOKEN=CHANGE_ME_LONG_RANDOM_METRICS_TOKEN
PASTEBOX_CORS_ALLOWED_ORIGINS=https://pastebox.example.com
PASTEBOX_RATE_LIMIT_ENABLED=true
PASTEBOX_RATE_LIMIT_WINDOW_SECONDS=60
PASTEBOX_RATE_LIMIT_AUTH=60
PASTEBOX_RATE_LIMIT_WRITE=300
PASTEBOX_RATE_LIMIT_UPLOAD=120
PASTEBOX_RATE_LIMIT_DOWNLOAD=600
PASTEBOX_RATE_LIMIT_WEBHOOK=300

PASTEBOX_POSTGRES_DB=pastebox
PASTEBOX_POSTGRES_USER=pastebox
PASTEBOX_POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD
PASTEBOX_DATABASE_URL=postgres://pastebox:CHANGE_ME_LONG_RANDOM_PASSWORD@postgres:5432/pastebox?sslmode=disable

PASTEBOX_REDIS_ADDR=redis:6379

PASTEBOX_S3_ENDPOINT=https://s3.example.com
PASTEBOX_S3_BUCKET=pastebox-prod
PASTEBOX_S3_REGION=us-east-1
PASTEBOX_S3_ACCESS_KEY=CHANGE_ME_OBJECT_STORAGE_ACCESS_KEY
PASTEBOX_S3_SECRET_KEY=CHANGE_ME_OBJECT_STORAGE_SECRET_KEY
PASTEBOX_S3_USE_PATH_STYLE=true

PASTEBOX_SCANNER_PROVIDER=clamav
PASTEBOX_CLAMAV_ADDR=clamav:3310
PASTEBOX_CLAMAV_TIMEOUT_SECONDS=30

PASTEBOX_MAILER_PROVIDER=smtp
PASTEBOX_SMTP_HOST=smtp.example.com
PASTEBOX_SMTP_PORT=587
PASTEBOX_SMTP_USERNAME=CHANGE_ME_SMTP_USERNAME
PASTEBOX_SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD
PASTEBOX_SMTP_FROM_EMAIL=noreply@pastebox.example.com
PASTEBOX_SMTP_FROM_NAME=PasteBox
PASTEBOX_SMTP_TLS_MODE=starttls

PASTEBOX_GOOGLE_OAUTH_CLIENT_ID=CHANGE_ME_GOOGLE_OAUTH_CLIENT_ID
PASTEBOX_GOOGLE_OAUTH_CLIENT_SECRET=CHANGE_ME_GOOGLE_OAUTH_CLIENT_SECRET
PASTEBOX_GOOGLE_OAUTH_REDIRECT_URL=https://pastebox.example.com/api/v1/auth/google/callback

PASTEBOX_STRIPE_ENABLED=true
PASTEBOX_STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME_STRIPE_WEBHOOK_SECRET
PASTEBOX_STRIPE_CHECKOUT_URL_TEMPLATE=https://billing.stripe.example.com/checkout?order_id={order_id}&plan_id={plan_id}&period={period}&amount_cents={amount_cents}&currency={currency}&success_url={success_url}&cancel_url={cancel_url}
PASTEBOX_EPUSDT_ENABLED=true
PASTEBOX_EPUSDT_PID=CHANGE_ME_EPUSDT_PID
PASTEBOX_EPUSDT_SECRET_KEY=CHANGE_ME_EPUSDT_SECRET_KEY
PASTEBOX_EPUSDT_CHECKOUT_URL_TEMPLATE=https://epusdt.example.com/pay?order_id={order_id}&amount_cents={amount_cents}&currency={currency}
PASTEBOX_EPUSDT_ADDRESS=CHANGE_ME_USDT_RECEIVE_ADDRESS
PASTEBOX_EPUSDT_CHAIN=USDT-TRC20

PASTEBOX_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
PASTEBOX_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_BOOTSTRAP_ADMIN_PASSWORD

PASTEBOX_BACKUP_RETENTION_DAYS=30
PASTEBOX_WAL_ARCHIVE_TIMEOUT_SECONDS=900
PASTEBOX_WAL_ARCHIVE_MAX_AGE_SECONDS=900
PASTEBOX_WAL_ARCHIVE_WAIT_SECONDS=60
PASTEBOX_PITR_RECOVERY_WAIT_SECONDS=300
PASTEBOX_RESTIC_REPOSITORY=s3:https://s3.example.com/pastebox-backups
PASTEBOX_RESTIC_PASSWORD=CHANGE_ME_LONG_RANDOM_RESTIC_PASSWORD
PASTEBOX_BACKUP_S3_ACCESS_KEY=CHANGE_ME_BACKUP_ACCESS_KEY
PASTEBOX_BACKUP_S3_SECRET_KEY=CHANGE_ME_BACKUP_SECRET_KEY
PASTEBOX_BACKUP_S3_REGION=us-east-1
