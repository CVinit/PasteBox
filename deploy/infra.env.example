# Copy to deploy/infra.env on the server. Do not commit the real file.

INFRA_COMPOSE_PROJECT_NAME=infra
POSTGRESQL_IMAGE=postgres:17-alpine
POSTGRESQL_SUPERUSER=postgres
POSTGRESQL_PASSWORD=CHANGE_ME_LONG_RANDOM_SUPERUSER_PASSWORD
POSTGRESQL_HOST_PORT=127.0.0.1:5432
POSTGRESQL_WAL_ARCHIVE_TIMEOUT_SECONDS=900

REDIS_IMAGE=redis:7-alpine
REDIS_HOST_PORT=127.0.0.1:6379

INFRA_NETWORK_SUBNET=172.30.0.0/24
POSTGRESQL_VOLUME=postgresql-data
REDIS_VOLUME=redis-data
POSTGRESQL_BACKUP_VOLUME=postgresql-backups
