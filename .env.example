# Local startup roots. Application and provider settings are configured in the admin console.
PASTEBOX_APP_ENV=development
PASTEBOX_DATABASE_URL=postgres://pastebox:pastebox@localhost:5432/pastebox?sslmode=disable
PASTEBOX_REDIS_ADDR=localhost:6379

# Set only when the API is behind a reverse proxy. Direct requests never trust forwarded IP headers.
PASTEBOX_TRUSTED_PROXY_CIDRS=

# Optional outside production. Production requires a Base64-encoded 32-byte key.
PASTEBOX_CONFIG_ENCRYPTION_KEY=
