PASTEBOX_APP_ENV=development
PASTEBOX_APP_NAME=PasteBox
PASTEBOX_HTTP_ADDR=:8080
PASTEBOX_PUBLIC_URL=http://localhost:5173
PASTEBOX_CSRF_SECRET=development-csrf-secret
PASTEBOX_RATE_LIMIT_ENABLED=true
PASTEBOX_RATE_LIMIT_WINDOW_SECONDS=60
PASTEBOX_RATE_LIMIT_AUTH=60
PASTEBOX_RATE_LIMIT_WRITE=300
PASTEBOX_RATE_LIMIT_UPLOAD=120
PASTEBOX_RATE_LIMIT_DOWNLOAD=600
PASTEBOX_RATE_LIMIT_WEBHOOK=300

PASTEBOX_DATABASE_URL=postgres://pastebox:pastebox@localhost:5432/pastebox?sslmode=disable
PASTEBOX_REDIS_ADDR=localhost:6379

PASTEBOX_S3_ENDPOINT=http://localhost:9000
PASTEBOX_S3_BUCKET=pastebox
PASTEBOX_S3_REGION=us-east-1
PASTEBOX_S3_ACCESS_KEY=pastebox
PASTEBOX_S3_SECRET_KEY=pastebox-secret
PASTEBOX_S3_USE_PATH_STYLE=true

PASTEBOX_SCANNER_PROVIDER=heuristic
PASTEBOX_CLAMAV_ADDR=localhost:3310
PASTEBOX_CLAMAV_TIMEOUT_SECONDS=30

PASTEBOX_MAILER_PROVIDER=log
PASTEBOX_STRIPE_ENABLED=false
PASTEBOX_STRIPE_WEBHOOK_SECRET=
PASTEBOX_EPUSDT_ENABLED=false
PASTEBOX_EPUSDT_PID=
PASTEBOX_EPUSDT_SECRET_KEY=

PASTEBOX_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
PASTEBOX_BOOTSTRAP_ADMIN_PASSWORD=change-me-admin-password
